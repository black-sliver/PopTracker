[codespell]
skip = ./.git,./packs,./nbproject,./lib,./build,./win32-lib,./win32-lib-src,./scan-build-reports,node_modules,./corpus,./examples/template_pack/scripts/custom_items/class.lua,./examples/template_pack/scripts/autotracking/archipelago.lua,*.pem,./src/gh/util/date.h,./prof.txt
